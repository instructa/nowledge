{
  "name": "nowledge-workspace",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@9.14.4+sha512.c8180b3fbe4e4bca02c94234717896b5529740a6cbadf19fa78254270403ea2f27d4e1d46a08a0f56c89b63dc8ebfd3ee53326da720273794e6200fcf0d184ab",
  "description": "MCP server for fetching any public web content and turning it into LLM readable markdown",
  "contributors": [
    {
      "name": "Kevin Kern",
      "email": "kevin@instructa.org"
    }
  ],
  "license": "MIT",
  "homepage": "https://github.com/instructa/nowledge",
  "repository": {
    "type": "git",
    "url": "https://github.com/instructa/nowledge.git"
  },
  "keywords": [
    "mcp",
    "mcp-starter",
    "model-context-protocol"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" build",
    "dev": "pnpm --filter \"./packages/*\" dev",
    "inspect": "npx @modelcontextprotocol/inspector@latest",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "pnpm --filter \"./packages/*\" typecheck",
    "test": "vitest",
    "release": "tsx scripts/release.ts",
    "dev:cli": "pnpm --filter @nowledge/cli dev",
    "dev:mcp": "pnpm --filter @nowledge/mcp dev",
    "dev:core": "pnpm --filter @nowledge/core dev",
    "nowledge": "pnpm --filter nowledge exec node ./dist/index.mjs"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.12.0",
    "@types/node": "^22.14.1",
    "@vitest/eslint-plugin": "^1.1.43",
    "dotenv": "^16.5.0",
    "esbuild": "^0.25.2",
    "eslint": "^9.25.1",
    "nodemon": "^3.1.9",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "unbuild": "^3.5.0",
    "vite": "^6.3.1",
    "vitest": "^3.1.1"
  }
}
